NODE_ENV=development
PORT=4000

# Postgres connection string, e.g. postgresql://user:pass@localhost:5432/moka
DATABASE_URL=postgresql://moka:moka@localhost:5432/moka

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# From your Paystack dashboard (use TEST keys until you're ready to go live)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Paystack signs webhooks with your secret key — same value as above, kept separate
# here in case you rotate one without the other.
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx

# Firebase service account (Project Settings -> Service Accounts -> Generate key)
FIREBASE_PROJECT_ID=moka-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@moka-xxxxx.iam.gserviceaccount.com
# Paste the private_key value from the JSON file, keeping the \n escape sequences as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Comma-separated list of allowed origins for the Flutter apps / admin panel, or * for dev
CORS_ORIGINS=*

# Where Paystack redirects the user after payment (deep link or web page that polls
# GET /api/payments/:reference/status)
PLATFORM_CALLBACK_URL=https://moka.example.com/payment-callback
